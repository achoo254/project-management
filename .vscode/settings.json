{
  // Bật Code Spell Checker extension
  "cSpell.enabled": true,
  
  // Chỉ kiểm tra spell check trong thư mục src/ (nếu có)
  // Bỏ qua tất cả các file/thư mục ngoài src/
  // Ignore tất cả file/thư mục ngoài src/ (nếu có)
  "cSpell.ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.git/**",
    "**/package*.json",
    "**/README.md",
    "**/*.md"
  ],
  
  // Chỉ kiểm tra các file trong src/ (nếu có)
  "cSpell.enabledLanguageIds": [
    "typescript",
    "javascript",
    "typescriptreact",
    "javascriptreact",
    "json"
  ]
}

