# Template cho file credentials — file thật nằm trên iCloud Drive, KHÔNG trong repo.
# Đường dẫn cụ thể xem trong scripts/load-env.sh (cố ý chỉ khai báo một chỗ).
# Nạp bằng: source scripts/load-env.sh
# sid/ssid: script lấy từ access-tokens.json (entry inet.vn) — 2 dòng dưới chỉ là dự phòng.
sid=
ssid=
GITLABS_USERNAME=
GITLABS_EMAIL=
GITLABS_ACCESS_TOKEN=
